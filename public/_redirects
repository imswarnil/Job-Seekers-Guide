# Courses and docs became one path at the root of the site.
#
# The route rules in nuxt.config.ts cover the fixed redirects so `pnpm dev`
# behaves the same, but two things need this file: a static host prerenders a
# route rule as a meta-refresh rather than a real 301, and there is no splat
# variable in a route rule — which is exactly what every old lesson URL needs.
#
# Cloudflare honours this file for both Pages and Workers static assets.

/courses/*                /:splat        301
/courses                  /start         301

# About stopped being a page and became a band of the front page.
/about                    /#about        301

# "How this course works" moved out of the terminal track when the orientation
# track was put in front of it.
/terminal/how-this-course-works/*  /orientation/how-this-course-works/:splat  301
/terminal/how-this-course-works    /orientation/how-this-course-works         301

/docs/getting-started/*   /#about        301
/docs/curriculum/*        /start         301
/docs/help/*              /faq           301
/docs/authoring/*         /#about        301
/docs/*                   /#about        301
/docs                     /#about        301

/blog/*                   /changelog     301
/blog                     /changelog     301

# The learning path moved from /path to /start.
/path                     /start         301

# The story is one page. It was three — an overview, a ten-part web series and
# the same story again as a flippable book — and a reader was being asked to pick
# a format before they had any reason to care. Every URL those three published
# lands on the page that replaced them.
/series/read              /my-story        301
/series/*                 /my-story        301
/series                   /my-story        301
/my-story/watch/*         /my-story        301
/my-story/watch           /my-story        301
/my-story/book/*          /my-story        301
/my-story/book            /my-story        301
