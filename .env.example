# Every setting the server reads. Copy to `.env` for `pnpm dev` and
# `pnpm db:migrate`; in production the same names are Worker secrets
# (`wrangler secret put NAME`) or plain vars in wrangler.jsonc.
#
# Names only. Never commit a value. With nothing set, the site still builds and
# renders: public numbers read as zero and every write answers 503.

# ── Neon Postgres ─────────────────────────────────────────────────────────────
# Neon console → project jobseekers-imswarnil → Connect → the pooled string.
# Or: npx neonctl connection-string --project-id <id> --pooled
DATABASE_URL=
# The project id, used by neonctl in docs/backend.md. Not read by the app.
NEON_PROJECT_ID=

# ── Neon Auth (Better Auth, managed by Neon) ──────────────────────────────────
# Neon console → the project → Auth → Configuration. The base URL ends in
# /neondb/auth (or similar) and is where /api/auth/* is proxied to.
NEON_AUTH_BASE_URL=
# Same page: the JWKS URL, used to verify Neon Auth JWTs sent as Bearer tokens.
NEON_AUTH_JWKS_URL=
# Same page. Not read by the server; kept for client SDKs that want it.
NEON_AUTH_PUB_CLIENT_KEY=
# Same page. Server only. When NEON_AUTH_COOKIE_SECRET is empty, the secret that
# signs the short-lived session cache cookie is derived from this.
NEON_AUTH_SECRET_SERVER_KEY=
# Optional. Any random string of 32+ characters (openssl rand -base64 32).
# Set it to rotate the session cache cookie without touching the Neon keys.
NEON_AUTH_COOKIE_SECRET=

# Comma-separated emails that may open /admin.
ADMIN_EMAILS=

# ── Dodo Payments ─────────────────────────────────────────────────────────────
# Dodo dashboard → Developer → API keys. Test keys start dodo_test_.
MY_DODO_API_KEY=
# Dodo dashboard → Developer → Webhooks → your endpoint → signing secret.
DODO_WEBHOOK_SECRET=
# test_mode or live_mode. Anything other than exactly live_mode is test mode.
DODO_ENV=test_mode
# Dodo dashboard → Products: two one-time, pay-what-you-want products in INR.
DODO_DONATION_PRODUCT_ID=
DODO_SPONSOR_PRODUCT_ID=

# ── Optional ──────────────────────────────────────────────────────────────────
# developers.giphy.com → Create an app → API key. Without it the guestbook takes
# a pasted GIPHY or Tenor link instead of searching.
GIPHY_API_KEY=

# The public origin. Canonical URLs, the sitemap, Dodo return URLs.
NUXT_PUBLIC_SITE_URL=https://jobseekers.imswarnil.com
